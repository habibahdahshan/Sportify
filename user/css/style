/* =====================
   Shop Pages Shared Styles
   ===================== */
:root {
  --color-text: #1a1a1a;
  --color-accent: #FF4D1C;
  --color-accent-light: rgba(255, 77, 28, 0.08);
  --color-surface: #ffffff;
  --color-border: #e8e8e8;
  --shadow-nav: 0 2px 12px rgba(0, 0, 0, 0.06);
  --font-display: 'Anton', 'Archivo Black', sans-serif;
  --transition: 0.2s ease;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Anton', serif;
  background: #f5f5f5;
}

/* =====================
   Navbar
   ===================== */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--color-surface);
  padding: 0 60px;
  height: 64px;
  box-shadow: var(--shadow-nav);
  position: sticky;
  top: 0;
  z-index: 200;
}

.navbar .logo {
  font-family: var(--font-display);
  font-size: clamp(1.25rem, 3vw, 1.65rem);
  font-style: italic;
  font-weight: 700;
  color: var(--color-text);
  text-decoration: none;
  z-index: 1002;
  flex-shrink: 0;
}

.navbar ul {
  list-style: none;
  display: flex;
  gap: 36px;
  align-items: center;
  height: 100%;
}

.navbar ul li {
  position: static;
  height: 100%;
  display: flex;
  align-items: center;
}

.navbar ul li a {
  text-decoration: none;
  color: var(--color-text);
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  padding: 4px 0;
  border-bottom: 2px solid transparent;
  transition: color var(--transition), border-color var(--transition);
}

.navbar ul li a:hover,
.navbar ul li:hover > a {
  color: var(--color-accent);
  border-bottom-color: var(--color-accent);
}

.navbar .icons {
  display: flex;
  gap: 18px;
  font-size: 18px;
  cursor: pointer;
  color: var(--color-text);
  align-items: center;
}

.navbar .icons span {
  position: relative;
  transition: color var(--transition);
}

.navbar .icons span:hover {
  color: var(--color-accent);
}

/* =====================
   Dropdown (Mega Menu)
   ===================== */
.dropdown {
  display: none;
  position: fixed;
  top: 64px; /* matches navbar height */
  left: 0;
  width: 100vw;
  background: var(--color-surface);
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
  justify-content: center;
  align-items: center;
  gap: 0;
  padding: 32px 0;
  z-index: 199;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
  animation: fadeSlideDown 0.2s ease forwards;
}

@keyframes fadeSlideDown {
  from { opacity: 0; transform: translateY(-6px); }
  to   { opacity: 1; transform: translateY(0); }
}

.dropdown a {
  padding: 10px 40px;
  font-size: 13px;
  font-weight: 500;
  margin-left: 35px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  text-decoration: none;
  color: var(--color-text);
  border-right: 1px solid var(--color-border);
  transition: color var(--transition), background var(--transition);
}

.dropdown a:last-child {
  border-right: none;
}

.dropdown a:hover {
  color: var(--color-accent);
  background: var(--color-accent-light);
}

.navbar ul li:hover .dropdown {
  display: flex;
}

/* Cart Button */
.cart {
  position: fixed;
  bottom: 30px;
  right: 30px;
  background: #1a1a1a;
  color: white;
  padding: 14px 28px;
  border-radius: 50px;
  cursor: pointer;
  font-weight: 600;
  z-index: 1000;
  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.2);
  transition: all 0.2s;
}

.cart:hover {
  background: #FF4D1C;
  transform: scale(1.02);
}

/* Cart Sidebar */
.cart-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1001;
}

.cart-overlay.open {
  display: block;
}

.cart-sidebar {
  position: fixed;
  top: 0;
  right: -420px;
  width: 400px;
  height: 100vh;
  background: white;
  z-index: 1002;
  display: flex;
  flex-direction: column;
  transition: right 0.3s ease;
  box-shadow: -5px 0 25px rgba(0, 0, 0, 0.15);
}

.cart-sidebar.open {
  right: 0;
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 24px;
  border-bottom: 1px solid #eee;
}

.cart-header h2 {
  font-size: 20px;
}

.close-btn {
  background: none;
  border: none;
  font-size: 24px;
  cursor: pointer;
  color: #999;
}

.cart-items {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
}

.empty-msg {
  text-align: center;
  color: #999;
  margin-top: 40px;
}

.cart-item {
  padding: 15px 0;
  border-bottom: 1px solid #f0f0f0;
}

.item-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10px;
}

.item-name {
  font-weight: 500;
}

.item-controls {
  display: flex;
  gap: 12px;
  align-items: center;
}

.qty-btn {
  width: 30px;
  height: 30px;
  border: 1px solid #ddd;
  background: #f5f5f5;
  border-radius: 8px;
  cursor: pointer;
  margin: 0;
  padding: 0;
}

.qty-btn:hover {
  background: #e0e0e0;
}

.remove-btn {
  background: none;
  border: none;
  font-size: 18px;
  cursor: pointer;
  color: #c0392b;
  margin-left: auto;
}

.cart-footer {
  padding: 20px;
  border-top: 1px solid #eee;
}

.cart-total {
  font-size: 18px;
  font-weight: 700;
  text-align: right;
  margin-bottom: 15px;
}

.checkout-btn {
  width: 100%;
  padding: 14px;
  background: #1a1a1a;
  color: white;
  border: none;
  border-radius: 10px;
  font-size: 15px;
  cursor: pointer;
  margin: 0;
}

.checkout-btn:hover {
  background: #333;
}

/* Responsive */
@media (max-width: 768px) {
  .navbar {
    padding: 0 20px;
  }
  .cart-sidebar {
    width: 320px;
  }
}
